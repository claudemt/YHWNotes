tmp/
refactor_*/

# FEQO 的叙述修订存档：59 MB 的渲染件、逐段修改记录与修改前对比 zip，
# 文件开头即写明"维护记录，不进入讲义正文"。
content/FreeElectronQuantumOptics/validation/
