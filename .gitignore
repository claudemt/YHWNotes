*.aux
*.log
*.out
*.toc
*.bcf
*.bbl
*.blg
*.run.xml
*.xdv
*.synctex.gz

# ===== Python =====
__pycache__/
*.pyc

# ===== Large local archives =====
*.zip

# ===== Temporary / scratch (never commit) =====
tmp/
refactor_*/

# ===== OS / editor =====
.DS_Store
Thumbs.db
~$*
